.page {
  padding-bottom: 160rpx;
}

/* 成员选择 */
.member-scroll {
  white-space: nowrap;
  padding: 8rpx 24rpx;
}

.member-list {
  display: inline-flex;
  gap: 24rpx;
}

.member-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  padding: 12rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.member-item.selected {
  background: #E8F8EF;
  box-shadow: 0 2rpx 12rpx rgba(7, 193, 96, 0.2);
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.member-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.member-name {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
}

.member-item.selected .member-name {
  color: #07C160;
  font-weight: 500;
}

/* 期初资产 */
.initial-tip {
  font-size: 24rpx;
  color: #999;
  background: #F5F7F5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.row-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.row-field:last-of-type {
  border-bottom: none;
}

.field-label {
  font-size: 28rpx;
  color: #666;
}

.picker-value {
  font-size: 28rpx;
  color: #1A1A1A;
}

.amount-input {
  font-size: 30rpx;
  font-weight: 600;
  text-align: right;
  width: 240rpx;
}

.save-btn {
  margin-top: 24rpx;
}

/* 快照列表 */
.snapshot-list {
  padding: 8rpx 24rpx;
}

.snapshot-item {
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.snapshot-item:last-child {
  border-bottom: none;
}

.snapshot-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07C160;
  margin-right: 20rpx;
}

.snapshot-info {
  flex: 1;
}

.snapshot-date {
  font-size: 28rpx;
  font-weight: 500;
}

.snapshot-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.snapshot-amount {
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.snapshot-del {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFF1F0;
  color: #FF4D4F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.add-wrap {
  padding: 32rpx 24rpx;
}

/* 弹层 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.editor {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  box-sizing: border-box;
}

.editor-title {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 32rpx;
}

.editor-field {
  margin-bottom: 28rpx;
}

.editor-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.editor-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}

.editor-btn {
  flex: 1;
  border-radius: 40rpx;
  font-size: 30rpx;
  padding: 22rpx 0;
  text-align: center;
  border: none;
  line-height: 1.4;
}

.editor-btn::after {
  border: none;
}

.editor-btn.cancel {
  background: #F0F2F0;
  color: #666;
}

.editor-btn.save {
  background: linear-gradient(135deg, #07C160 0%, #10D96F 100%);
  color: #fff;
}
