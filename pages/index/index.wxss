.page {
  padding-bottom: 200rpx;
}

/* 总资产卡片 */
.hero {
  background: linear-gradient(135deg, #07C160 0%, #10D96F 55%, #4BE39A 100%);
  margin: 24rpx;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  color: #fff;
  box-shadow: 0 12rpx 32rpx rgba(7, 193, 96, 0.35);
  position: relative;
  overflow: hidden;
}

.hero::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero::after {
  content: '';
  position: absolute;
  bottom: -100rpx;
  left: -40rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-label {
  font-size: 26rpx;
  opacity: 0.9;
  position: relative;
  z-index: 1;
}

.hero-enter {
  font-size: 22rpx;
  opacity: 0.85;
  margin-left: 12rpx;
}

.hero-amount {
  font-size: 76rpx;
  font-weight: 700;
  margin: 16rpx 0 28rpx;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.hero-growth {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.growth-item {
  flex: 1;
}

.growth-label {
  font-size: 24rpx;
  opacity: 0.95;
}

.growth-value {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  font-weight: 700;
}

.growth-arrow {
  font-size: 20rpx;
  margin-right: 8rpx;
  opacity: 1;
}

.growth-sign {
  font-size: 30rpx;
  margin-right: 4rpx;
}

.growth-amount {
  font-size: 36rpx;
  letter-spacing: 0.5rpx;
}

/* 正（增加）为红色，负（减少）为绿色 */
.growth-up {
  color: #FF5A5A;
}

.growth-down {
  color: #E8FFF2;
}

.growth-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  margin: 0 24rpx;
}

/* 区块卡片 */
.section-card {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-more {
  font-size: 24rpx;
  color: #07C160;
}

/* 饼图图例 */
.pie-legend {
  margin-top: 16rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.legend-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.legend-amount {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
}

/* 趋势卡片 */
.trend-card {
  padding: 24rpx 24rpx 16rpx;
}

.trend-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.trend-title {
  font-size: 30rpx;
  font-weight: 600;
}

.trend-tabs {
  display: flex;
  background: #F0F2F0;
  border-radius: 20rpx;
  padding: 4rpx;
}

.trend-tab {
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

.trend-tab.active {
  background: #fff;
  color: #07C160;
  font-weight: 500;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

/* 记录列表 */
.record-list {
  padding: 8rpx 24rpx;
}

/* 左滑容器 */
.record-swipe {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #F5F5F5;
}

.record-swipe:last-child {
  border-bottom: none;
}

/* 底部操作按钮 */
.record-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
}

.record-action {
  width: 90px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
}

.record-action.edit {
  background: #07C160;
}

.record-action.delete {
  background: #FF4D4F;
}

.record-item {
  position: relative;
  display: flex;
  align-items: center;
  padding: 24rpx 8rpx;
  background: #fff;
}

.record-item:last-child {
  border-bottom: none;
}

.record-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.record-info {
  flex: 1;
}

.record-name {
  font-size: 28rpx;
  font-weight: 500;
}

.record-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.record-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.amount-income {
  color: #FF4D4F;
}

.amount-expense {
  color: #07C160;
}

.amount-asset {
  color: #42A5F5;
}

/* 按日分组 */
.day-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 8rpx 8rpx;
}

.day-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
}

.day-line {
  flex: 1;
  height: 1rpx;
  background: #E5E5E5;
}

.empty-tip {
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}
