.record-page {
  padding-bottom: 200rpx;
}

/* 类型切换 */
.type-switch {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  padding: 32rpx 24rpx 8rpx;
  flex-wrap: nowrap;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
  white-space: nowrap;
}

.type-btn.active.expense {
  background: linear-gradient(135deg, #FF4D4F 0%, #FF7875 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(255, 77, 79, 0.3);
}

.type-btn.active.income {
  background: linear-gradient(135deg, #07C160 0%, #10D96F 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(7, 193, 96, 0.3);
}

.type-btn.active.asset {
  background: linear-gradient(135deg, #42A5F5 0%, #64B5F6 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(66, 165, 245, 0.3);
}

.type-btn.active.liability {
  background: linear-gradient(135deg, #FF7043 0%, #FF8A65 100%);
  color: #fff;
  box-shadow: 0 6rpx 16rpx rgba(255, 112, 67, 0.3);
}

/* 资产范围切换 */
.goal-type-row {
  display: flex;
  gap: 16rpx;
}

.goal-type-option {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  background: #F5F5F5;
  color: #666;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.goal-type-option.selected {
  background: #E8F8EF;
  color: #07C160;
  font-weight: 600;
  box-shadow: 0 0 0 2rpx #07C160;
}

/* 金额输入 */
.amount-input {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 0 48rpx;
}

.amount-symbol {
  font-size: 56rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-right: 12rpx;
}

.amount-field {
  font-size: 72rpx;
  font-weight: 700;
  width: 520rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
}

.amount-placeholder {
  color: #CCCCCC;
}

/* 卡片字段 */
.card {
  margin: 20rpx 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.row-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.row-field .field-label {
  margin-bottom: 0;
}

.picker-value {
  font-size: 30rpx;
  color: #1A1A1A;
}

/* 备注输入框（独立输入框，带提示词） */
.remark-input {
  display: block;
  margin: 20rpx 24rpx;
  padding: 24rpx 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E0E0E0;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 分类/成员横向滚动 */
.cat-scroll {
  white-space: nowrap;
}

.cat-list {
  display: inline-flex;
  gap: 24rpx;
  padding: 4rpx;
}

.cat-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.cat-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.cat-item.selected .cat-icon {
  border-width: 3rpx;
  transform: scale(1.05);
}

.cat-name {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}

.cat-item.selected .cat-name {
  color: #07C160;
  font-weight: 500;
}

.member-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  transition: all 0.15s ease;
}

.cat-item.selected .member-avatar {
  box-shadow: 0 0 0 4rpx #07C160;
  transform: scale(1.05);
}

.member-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 提交 */
.submit-wrap {
  padding: 32rpx 24rpx;
}
