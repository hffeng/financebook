/* 中间凸起记账按钮 */
.center-item {
  flex: 0 0 140rpx;
}

.center-icon-wrap {
  position: absolute;
  top: 0;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #07C160 0%, #10D96F 100%);
  box-shadow: 0 10rpx 24rpx rgba(7, 193, 96, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.center-item:active .center-icon-wrap {
  transform: scale(0.92);
}

.center-icon {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.center-plus {
  position: relative;
  width: 48rpx;
  height: 48rpx;
}

.plus-h,
.plus-v {
  position: absolute;
  background: #FFFFFF;
  border-radius: 6rpx;
}

.plus-h {
  left: 0;
  top: 50%;
  width: 48rpx;
  height: 6rpx;
  transform: translateY(-50%);
}

.plus-v {
  top: 0;
  left: 50%;
  width: 6rpx;
  height: 48rpx;
  transform: translateX(-50%);
}

.tab-text {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.tab-item.active .tab-text {
  color: #07C160;
  font-weight: 600;
}
